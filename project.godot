[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/soft_body_point_radius=0.002

[rendering]

limits/global_shader_variables/buffer_size=262144

renderer/rendering_method.mobile="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
reflections/sky_reflections/ggx_samples=64
reflections/sky_reflections/fast_filter_high_quality=true
reflections/reflection_atlas/reflection_size=512
textures/default_filters/anisotropic_filtering_level=4
camera/depth_of_field/depth_of_field_bokeh_quality=2
camera/depth_of_field/depth_of_field_use_jitter=true
environment/ssao/quality=3
environment/ssil/quality=3
anti_aliasing/quality/use_debanding=true
textures/default_filters/texture_mipmap_bias=-0.2
environment/screen_space_reflection/half_size=false
environment/subsurface_scattering/subsurface_scattering_quality=2
global_illumination/sdfgi/probe_ray_count=3
global_illumination/sdfgi/frames_to_update_lights=1
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128
anti_aliasing/quality/use_taa=true
mesh_lod/lod_change/threshold_pixels=2.0

[shader_globals]

pond_time={
"type": "float",
"value": 0.0
}
pond_interaction_enabled={
"type": "bool",
"value": false
}
pond_interaction_bounds={
"type": "vec4",
"value": Vector4(-58, -20, 48, 48)
}
pond_interaction_tex={
"type": "sampler2D",
"value": ""
}

rainfall={
"type": "float",
"value": 0.0
}
scene_wetness={
"type": "float",
"value": 0.0
}
lightning_flash={
"type": "float",
"value": 0.0
}
lightning_position={
"type": "vec3",
"value": Vector3(-900, 270, -160)
}


sun_direction={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
sun_color={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
daylight={
"type": "float",
"value": 1.0
}
water_level={
"type": "float",
"value": -0.9
}
wind_direction={
"type": "vec2",
"value": Vector2(1, 0.3)
}
wind_strength={
"type": "float",
"value": 1.0
}
impostor_bake={
"type": "int",
"value": 0
}
player_position={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
fire_position={
"type": "vec3",
"value": Vector3(0, 0.5, 0)
}
fire_intensity={
"type": "float",
"value": 1.0
}

[dotnet]

project/assembly_name="LastCamp"
