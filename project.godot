; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Last Camp"
config/description="A playable forest campsite and cinematic rendering demo for Godot 4.8 dev6 .NET, combining procedural terrain and vegetation with credited photoscanned dressing and materials."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.02, 0.02, 0.03, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/core/Game.cs"
Quality="*res://scripts/core/Quality.cs"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/mjpeg_quality=0.94

[filesystem]

import/blender/enabled=false

