<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Patched GodotSharp, fleet1 build: godot-headless and godot-offscreen export GODOT_FLEET1_NUPKGS. -->
    <add key="godot-fleet1" value="%GODOT_FLEET1_NUPKGS%" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="godot-fleet1">
      <package pattern="GodotSharp" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
