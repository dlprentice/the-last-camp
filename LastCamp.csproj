<Project Sdk="Godot.NET.Sdk/4.8.0-beta.4">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>LastCamp</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
    <UseSharedCompilation>false</UseSharedCompilation>
    <DefaultItemExcludes>$(DefaultItemExcludes);local-data/**;.qa/**;.worktrees/**;.claude/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Compile Remove="tests/**/*.cs;tools/**/*.cs" />
  </ItemGroup>
  <!-- Patched GodotSharp, fleet1 build (godot#125198), from the directory GODOT_FLEET1_NUPKGS names.
       Remove this block and nuget.config when the engine leaves beta4. -->
  <PropertyGroup>
    <DisableImplicitGodotSharpReferences>true</DisableImplicitGodotSharpReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.8.0-beta.4-fleet1" />
    <PackageReference Include="GodotSharpEditor" Version="$(PackageVersion_GodotSharp)" Condition=" '$(Configuration)' == 'Debug' " />
  </ItemGroup>
</Project>
